{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jokers-circus-production",
  "main": "cloud/worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist-arcade-production",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CIRCUS_PROJECT",
        "class_name": "CircusProject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CircusProject"
      ]
    }
  ],
  "vars": {
    "ADMIN_DAILY_MAX": "1000000",
    "ADMIN_GRANT_MAX": "100000",
    "ALLOWED_GUILD_IDS": "1503958213454856252",
    "APP_ENV": "production",
    "CLOUD_PLAN": "paid",
    "DISCORD_CLIENT_ID": "1561284960986599626",
    "DISCORD_HIGHLIGHTS_GUILD_ID": "",
    "DISCORD_HIGHLIGHTS_WEBHOOK_URL": "",
    "DISCORD_PUBLIC_KEY": "b46c60cd5caf77520794fab64bb6de7036e0c1dc91aaa0038b1f9c3ea8e8f25f",
    "FIRESTORE_ENDPOINT": "https://firestore.asia-east1.rep.googleapis.com",
    "FIRESTORE_NAMESPACE": "jokers-circus-v2-20261030-production",
    "FIRESTORE_PROJECT_ID": "jokers-circus-production",
    "WEEKLY_CHECKIN_REWARDS": "500,500,1000,1000,1000,2000,4000",
    "DISCORD_COMMAND_CHANNEL_IDS": "1565731918107115690",
    "ADMIN_ROLE_IDS": "",
    "DISCORD_CASINO_ENABLED": "true",
    "DISCORD_CASINO_GUILD_ID": "1503958213454856252",
    "DISCORD_CASINO_CHANNEL_ID": "1565731918107115690",
    "ARCADE_RELEASE_ENABLED": "true"
  },
  "observability": {
    "enabled": false
  }
}
