{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jokers-circus-arcade-test",
  "main": "cloud/worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist-arcade-test",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {"bindings": [{"name": "CIRCUS_PROJECT", "class_name": "CircusProject"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["CircusProject"]}],
  "vars": {
    "APP_ENV": "test",
    "CLOUD_PLAN": "paid",
    "FIRESTORE_PROJECT_ID": "slot-game-203db",
    "FIRESTORE_NAMESPACE": "jokers-circus-arcade-test",
    "FIRESTORE_ENDPOINT": "https://firestore.us.rep.googleapis.com",
    "DISCORD_CLIENT_ID": "1567875182792544256",
    "DISCORD_PUBLIC_KEY": "0589ecc2ee0191e2e8d360d5a157676610364c871bb7ef016ef80338fe0299bb",
    "ALLOWED_GUILD_IDS": "760012177326997544",
    "DISCORD_COMMAND_CHANNEL_IDS": "1564243344857632818",
    "DISCORD_COMMAND_PROFILE": "test-simple",
    "ARCADE_RELEASE_ENABLED": "true",
    "ARCADE_CG_PREVIEW_ALL": "true"
  },
  "observability": {"enabled": false}
}
